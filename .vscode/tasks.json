{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build schedule app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Install schedule dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build schedule app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run schedule tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild schedule app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Install Tailwind v4",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"-D",
				"tailwindcss",
				"@tailwindcss/vite"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final build schedule app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Final schedule tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify clean production build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Start schedule dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Initialize schedule repository",
			"type": "shell",
			"command": "git",
			"args": [
				"init"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Set GitHub origin",
			"type": "shell",
			"command": "git",
			"args": [
				"remote",
				"add",
				"origin",
				"https://github.com/leonardomartim/schedule.github.io.git"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage schedule MVP",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review staged schedule files",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove generated artifacts",
			"type": "shell",
			"command": "git",
			"args": [
				"rm",
				"--cached",
				"-r",
				"dist",
				"tsconfig.tsbuildinfo",
				"tsconfig.node.tsbuildinfo",
				"vite.config.js",
				"vite.config.d.ts"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restage clean schedule files",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}